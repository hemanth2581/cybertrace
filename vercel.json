{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/css/(.*)",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "/img/(.*)",
      "dest": "/frontend/img/$1"
    },
    {
      "src": "/index.html",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/upload.html",
      "dest": "/frontend/upload.html"
    },
    {
      "src": "/events.html",
      "dest": "/frontend/events.html"
    },
    {
      "src": "/anomalies.html",
      "dest": "/frontend/anomalies.html"
    },
    {
      "src": "/investigation.html",
      "dest": "/frontend/investigation.html"
    },
    {
      "src": "/timeline.html",
      "dest": "/frontend/timeline.html"
    },
    {
      "src": "/evidence.html",
      "dest": "/frontend/evidence.html"
    },
    {
      "src": "/investigator.html",
      "dest": "/frontend/investigator.html"
    },
    {
      "src": "/report.html",
      "dest": "/frontend/report.html"
    },
    {
      "src": "/how-it-works.html",
      "dest": "/frontend/how-it-works.html"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
